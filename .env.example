# Supabase (servidor). Sem estas variáveis, em desenvolvimento a LP usa um banco local em .data/db.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHORT_DOMAIN=bora.com.br

# Analytics (opcionais)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Antibot (opcional). Sem chave, usa honeypot + tempo mínimo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Checkout do Aluno Fundador (opcional). Sem URL, o botão mostra "em breve".
NEXT_PUBLIC_CHECKOUT_URL=

# Segredo para assinar cookies de lead
LEAD_COOKIE_SECRET=troque-este-valor
